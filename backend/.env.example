# ── Backend Environment Variables ────────────────────────────────────────────
# Copy to backend/.env and fill in values.
# On Railway: set these in your service → Variables tab.

# Groq API key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated list of allowed CORS origins (add your Vercel URL after deploy)
# Example: https://legal-copilot.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
